# 조회 조건 (공개 저장소에 올라가는 파일 — 키/토큰은 절대 넣지 말 것)
# 시도:시군구 를 ; 로 구분. 시군구 생략하면 시도 전체. 예) 경기도:화성시;경기도:평택시;서울특별시
REGIONS=경기도:화성시
# 수의계약가능여부 N / Y / N,Y
PVCT_TRGT_YN=N
# 처분방식 0001=매각, 0002=임대, 비우면 전체
DSPS_MTHOD_CD=0001
# 재산유형 비우면 전체 (0007 압류, 0010 국유, 0005 기타일반, 0002 공유, 0003 금융권담보 ...)
PRPT_DIV_CD=
# 한 번 실행에 보낼 최대 카톡 수
MAX_NOTIFY=20
# 카톡 버튼 링크 (카카오 개발자 콘솔 > 플랫폼 > Web 사이트 도메인에 등록돼 있어야 열림)
LINK_URL=https://coldankim.github.io/SolarAuction/
# --auth 재발급 시 사용하는 Redirect URI (카카오 콘솔에 등록된 값과 같아야 함)
KAKAO_REDIRECT_URI=https://localhost

# 태양광 계통 기준 (kW): 변전소·주변압기·배전선로 여유 중 가장 작은 값 기준
# MIN 이상이면 알림 대상, GOOD 이상이면 "300kW+" 표시
SOLAR_MIN_KW=100
SOLAR_GOOD_KW=300
# 브이월드 인증키에 등록한 서비스 URL (요청에 같이 보내야 함)
VWORLD_DOMAIN=https://coldankim.github.io
